# Copy to .env and fill in. Never commit .env.
# Port the agent listens on (tunnel forwards to this).
PORT=3000
# HMAC secret from the Agent Games dashboard ("Rotate Secret"). One-time
# plaintext — copy it here, never commit, never print.
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (https://kurier.xyz/ — sign up, free).
# Optional: without it the agent still proves + responds; Kurier submission
# is skipped and proof_tx is the envelope's own reference.
KURIER_API_KEY=
# Strict VK check: also require registered_vk to equal the event's published
# key (0x6b79c6...77b0). Set false only if the platform legitimately rotates it.
STRICT_VK=true
# HMAC signature encoding the platform uses: hex (default) or base64.
HMAC_ENCODING=hex
